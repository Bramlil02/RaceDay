@model EventFormViewModel

@{
    ViewData["Title"] = "Create event";
}

<div class="container">
    <div class="rd-page-header">
        <h1>Create event</h1>
        <p>Fill in the details, add a banner, then set up the categories.</p>
    </div>

    <div class="rd-panel">
        <form asp-action="CreateEvent" method="post" enctype="multipart/form-data" novalidate>
            <partial name="_EventForm" model="Model" />

            <div class="mt-4">
                <button type="submit" class="btn btn-rd-primary">Create event</button>
                <a asp-action="Events" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
