@model EventFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<input type="hidden" asp-for="EventID" />
<input type="hidden" asp-for="OrganizerID" />
<input type="hidden" asp-for="RouteID" />
<input type="hidden" asp-for="ExistingBannerUrl" />

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="EventName" class="form-label"></label>
        <input asp-for="EventName" class="form-control" />
        <span asp-validation-for="EventName" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="CategoryID" class="form-label"></label>
        <select asp-for="CategoryID" asp-items="Model.EventTypeItems" class="form-select">
            <option value="">Select a type...</option>
        </select>
        <span asp-validation-for="CategoryID" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" rows="4" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="EventDate" class="form-label"></label>
        <input asp-for="EventDate" type="date" class="form-control" />
        <span asp-validation-for="EventDate" class="text-danger"></span>
    </div>

    <div class="col-md-8">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" type="number" step="0.01" min="0.1" class="form-control" />
        <span asp-validation-for="DistanceKm" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="EntryFee" class="form-label"></label>
        <input asp-for="EntryFee" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="EntryFee" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Status" class="form-label">Status</label>
        <select asp-for="Status" class="form-select">
            <option value="Open">Open</option>
            <option value="Closed">Closed</option>
            <option value="Cancelled">Cancelled</option>
        </select>
    </div>

    <div class="col-12">
        <label asp-for="Banner" class="form-label"></label>

        @if (!string.IsNullOrWhiteSpace(Model.ExistingBannerUrl))
        {
            <div class="mb-2">
                <img src="@Model.ExistingBannerUrl" alt="Current banner" style="max-height:140px;border-radius:8px;" />
            </div>
        }

        <input asp-for="Banner" type="file" class="form-control" accept="image/jpeg,image/png,image/webp,image/gif" />
        <div class="form-text">JPG, PNG, WEBP or GIF, up to 5 MB. Uploading a new image replaces the current one.</div>
    </div>
</div>
