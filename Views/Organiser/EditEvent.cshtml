@model EventFormViewModel

@{
    ViewData["Title"] = "Edit event";
}

<div class="container">
    <div class="rd-page-header">
        <h1>Edit event</h1>
        <p>@Model.EventName</p>
    </div>

    <div class="rd-panel">
        <form asp-action="EditEvent" method="post" enctype="multipart/form-data" novalidate>
            <partial name="_EventForm" model="Model" />

            <div class="mt-4">
                <button type="submit" class="btn btn-rd-primary">Save changes</button>
                <a asp-action="Events" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
